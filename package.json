{
  "name": "japanese-tutor",
  "version": "0.3.2",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test:review": "node --experimental-strip-types --test src/engine/reviewEngine.test.ts",
    "test:kana": "node --experimental-strip-types --test src/engine/kanaEngine.test.ts",
    "test:kana-words": "node --experimental-strip-types --test src/engine/kanaWordEngine.test.ts",
    "test": "npm run test:review && npm run test:kana && npm run test:kana-words",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
